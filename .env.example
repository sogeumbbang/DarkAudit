# .env로 복사한 뒤 비밀 값을 채운다. 키 없이 데모만 돌리려면 DARKAUDIT_PROVIDER=fake.

# 분석 프로바이더. fake는 API 키 없이 데모가 동작하고, openai는 OPENAI_API_KEY가 필요하다.
DARKAUDIT_PROVIDER=openai
DARKAUDIT_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
# 스마트 탐색(Computer Use)을 쓸 때만 필요
DARKAUDIT_COMPUTER_MODEL=gpt-5.6-luna

# 다크패턴 챗봇(RAG, docs/chatbot.md). false면 /api/v1/chat 을 끈다.
DARKAUDIT_CHATBOT_ENABLED=true
# 비우면 답변은 DARKAUDIT_MODEL, 검색은 text-embedding-3-large를 쓴다.
DARKAUDIT_CHAT_MODEL=
DARKAUDIT_EMBEDDING_MODEL=

# 이미지 업로드 bbox grounding. Docker에는 kor+eng Tesseract가 포함된다.
# 로컬에서 OCR을 명시적으로 끄려면 none으로 설정한다.
DARKAUDIT_OCR_PROVIDER=tesseract
DARKAUDIT_TESSERACT_LANG=kor+eng
# 비우면 PATH의 tesseract를 쓴다. Windows에서 PATH에 없으면 tesseract.exe 전체 경로를 넣는다.
DARKAUDIT_TESSERACT_COMMAND=

# 프론트 노출 게이트. 기본값이 v2 라 비워둬도 되고, 롤백이 필요할 때만 v1 로 내린다.
DARKAUDIT_FRONTEND_CONTRACT=v2

# Figma 임포트 (docs/figma_fastapi_handoff.md).
# Figma > Settings > Personal access tokens 에서 file_content:read 로 발급한다.
FIGMA_ACCESS_TOKEN=
# 심사위원용 Figma 데모 파일. 비워 두면 Figma 데모 버튼을 비활성화합니다.
DARKAUDIT_DEMO_FIGMA_URL=https://www.figma.com/design/YtP0tCCij8KTBOiZXkzh9B/DarkAudit-Mobile-Banking-Mockup
FIGMA_API_BASE_URL=https://api.figma.com/v1
FIGMA_HTTP_TIMEOUT_SECONDS=30
FIGMA_RENDER_SCALE=2
FIGMA_MAX_FRAMES=20

# Android APK 분석 (BrowserStack App Automate)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BROWSERSTACK_ANDROID_DEVICE=Google Pixel 8
BROWSERSTACK_ANDROID_VERSION=14.0
# 수집 화면 수와 탐색 시도 횟수는 별개 예산이다. (코드에서 화면 수는 최대 6, 시도는 최대 50으로 제한)
ANDROID_MAX_SCREENS=10
ANDROID_MAX_ACTIONS=20
